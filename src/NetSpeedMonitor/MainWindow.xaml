<Window x:Class="NetSpeedMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetSpeedMonitor.Controls"
        Title="NetSpeedMonitor"
        Width="280" Height="348"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="40" Top="40"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="OnWindowMouseDown"
        MouseMove="OnWindowMouseMove"
        MouseLeftButtonUp="OnWindowMouseUp">

  <Window.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8A8F98"/>
    <SolidColorBrush x:Key="AccentDown" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentUp" Color="#FF9E6D"/>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#22FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="Background" Value="#33FFB020"/>
      <Setter Property="Foreground" Value="#FFD08A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#55FFB020"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#2A4CC2FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,7,0" Data="M0,0 L8,0 L4,5 Z"
                            Fill="{StaticResource TextSecondary}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#2AFFFFFF"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

              <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                     Focusable="False" PopupAnimation="Slide"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="#F2161A20" BorderBrush="#2AFFFFFF" BorderThickness="1"
                        CornerRadius="6" Margin="0,2,0,0" Padding="2"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
  <Border x:Name="PanelRoot" CornerRadius="12" Background="#E614161A" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="14,10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="AdapterPicker" Style="{StaticResource DarkCombo}"
                  VerticalAlignment="Center"
                  SelectionChanged="OnAdapterSelectionChanged"/>
        <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource IconButton}"
                Margin="6,0,0,0"
                HorizontalAlignment="Right" Content="✕" Click="OnCloseClick"/>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="↓" Foreground="{StaticResource AccentDown}" FontSize="18"
                   VerticalAlignment="Bottom" Margin="0,0,8,3"/>
        <TextBlock x:Name="DownMain" Text="0.00"
                   Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold"
                   VerticalAlignment="Bottom"/>
        <TextBlock Text=" MB/s" Foreground="{StaticResource TextSecondary}" FontSize="11"
                   VerticalAlignment="Bottom" Margin="2,0,0,6"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
        <TextBlock Text="↑" Foreground="{StaticResource AccentUp}" FontSize="16"
                   VerticalAlignment="Bottom" Margin="0,0,8,3"/>
        <TextBlock x:Name="UpMain" Text="0.00"
                   Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"
                   VerticalAlignment="Bottom"/>
        <TextBlock Text=" MB/s" Foreground="{StaticResource TextSecondary}" FontSize="11"
                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
      </StackPanel>

      <controls:Sparkline x:Name="Trend" Grid.Row="3"
                          Margin="0,8,0,0" Height="34"
                          Stroke="{StaticResource AccentDown}"/>

      <Border x:Name="Banner" Grid.Row="4" Background="#26FFB020" CornerRadius="6"
              Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
        <Grid>
          <TextBlock Text="未提权，进程速率不可用" FontSize="10" Foreground="#FFD08A"
                     VerticalAlignment="Center" Margin="0,0,86,0" TextWrapping="Wrap"/>
          <Button Content="以管理员重启" Style="{StaticResource SmallButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="OnRestartClick"/>
        </Grid>
      </Border>

      <TextBlock Grid.Row="5" x:Name="ProcessHeader" Text="进程速率"
                 Foreground="{StaticResource TextSecondary}" FontSize="10"
                 Margin="0,10,0,2" Visibility="Collapsed"/>

      <TextBlock Grid.Row="5" x:Name="ConnectionHeader" Text="进程连接"
                 Foreground="{StaticResource TextSecondary}" FontSize="10"
                 Margin="0,10,0,2" Visibility="Collapsed"/>

      <ItemsControl x:Name="ConnectionList" Grid.Row="6" Visibility="Collapsed">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="22">
              <Border Height="16" Width="{Binding BarWidth}" HorizontalAlignment="Left"
                      Background="#1F8A8F98" CornerRadius="3" VerticalAlignment="Center"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl x:Name="ProcessList" Grid.Row="6" Visibility="Collapsed">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="22">
              <Border Height="16" Width="{Binding BarWidth}" HorizontalAlignment="Left"
                      Background="#1F4CC2FF" CornerRadius="3" VerticalAlignment="Center"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding DownText}" FontSize="11"
                           Foreground="{StaticResource AccentDown}" VerticalAlignment="Center"
                           Margin="8,0,0,0" Width="40" TextAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding UpText}" FontSize="11"
                           Foreground="{StaticResource AccentUp}" VerticalAlignment="Center"
                           Margin="6,0,0,0" Width="34" TextAlignment="Right"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="7" x:Name="Footer" Text=""
                 Foreground="{StaticResource TextSecondary}" FontSize="10"
                 Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>

  <Border x:Name="BallRoot" Width="76" Height="76" CornerRadius="38"
          Background="#E614161A" BorderBrush="#2AFFFFFF" BorderThickness="1"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Visibility="Collapsed" Cursor="Hand">
    <Grid Margin="2,5">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="BallUp" Text="↑ 0.00"
                 Foreground="{StaticResource AccentUp}" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <TextBlock Grid.Row="1" Text="MB/s" Foreground="{StaticResource TextSecondary}"
                 FontSize="8" HorizontalAlignment="Center" Margin="0,1"/>

      <TextBlock x:Name="BallDown" Grid.Row="2" Text="↓ 0.00"
                 Foreground="{StaticResource AccentDown}" FontSize="13" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </Border>
  </Grid>
</Window>
